    "To add it, touch and hold the Home Screen, tap Edit, then Add Widget, and choose Offhand." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So fügst du es hinzu: Halte den Home-Bildschirm gedrückt, tippe auf „Bearbeiten“, dann auf „Widget hinzufügen“ und wähle Offhand."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To add it, touch and hold the Home Screen, tap Edit, then Add Widget, and choose Offhand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para añadirlo, mantén pulsada la pantalla de inicio, toca Editar, luego Añadir widget y elige Offhand."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे जोड़ने के लिए होम स्क्रीन को दबाकर रखें, संपादित करें पर टैप करें, फिर विजेट जोड़ें, और Offhand चुनें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para adicionar, toque e mantenha pressionada a Tela de Início, toque em Editar, depois em Adicionar Widget e escolha o Offhand."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы добавить его, нажмите и удерживайте экран «Домой», нажмите «Править», затем «Добавить виджет» и выберите Offhand."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб додати його, натисніть і утримуйте початковий екран, торкніться «Редагувати», потім «Додати віджет» і виберіть Offhand."
          }
        }
      }
