    "%@ of audio and its transcript will be deleted. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Audio und das Transkript werden gelöscht. Das lässt sich nicht rückgängig machen."
