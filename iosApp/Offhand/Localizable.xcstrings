    "%1$@ writes notes in the %2$@ style, so these notes will be rewritten. Your transcripts do not change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schreibt Notizen im Stil %2$@, deshalb werden diese Notizen neu geschrieben. Deine Transkripte bleiben, wie sie sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ writes notes in the %2$@ style, so these notes will be rewritten. Your transcripts do not change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ escribe las notas con el estilo %2$@, así que estas notas se volverán a escribir. Tus transcripciones no cambian."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ नोट्स को %2$@ शैली में लिखता है, इसलिए ये नोट फिर से लिखे जाएँगे। आपकी ट्रांसक्रिप्ट नहीं बदलतीं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ escreve as notas no estilo %2$@, então estas notas serão reescritas. Suas transcrições não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В папке «%1$@» заметки пишутся в стиле «%2$@», поэтому эти заметки будут переписаны. Расшифровки не изменятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У папці «%1$@» нотатки пишуться в стилі «%2$@», тому ці нотатки буде переписано. Розшифровки не зміняться."
          }
        }
      }
    },
