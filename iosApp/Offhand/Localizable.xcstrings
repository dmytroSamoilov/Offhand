    "Turn on microphone access to record a note. Audio still never leaves this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere den Mikrofonzugriff, um eine Notiz aufzunehmen. Audio verlässt dieses Gerät trotzdem nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el acceso al micrófono para grabar una nota. Aun así, el audio nunca sale de este dispositivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नोट रिकॉर्ड करने के लिए माइक्रोफ़ोन की अनुमति चालू करें। ऑडियो फिर भी कभी इस डिवाइस से बाहर नहीं जाता।"
