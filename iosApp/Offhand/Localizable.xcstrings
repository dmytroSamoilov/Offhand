    "Included on this iPhone. It is not part of backups and does not survive a reinstall." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem iPhone enthalten. Nicht Teil von Backups, und eine Neuinstallation setzt es zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluido en este iPhone. No forma parte de las copias de seguridad y no sobrevive a una reinstalación."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर शामिल है। यह बैकअप का हिस्सा नहीं है और दोबारा इंस्टॉल करने पर नहीं रहता।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluído neste iPhone. Não faz parte dos backups e não sobrevive a uma reinstalação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено на этом iPhone. Не входит в резервные копии и не сохраняется после переустановки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включено на цьому iPhone. Не входить до резервних копій і не зберігається після перевстановлення."
          }
        }
      }
    },
    "It will keep processing on this device. You can close this." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verarbeitung läuft auf diesem Gerät weiter. Du kannst das hier schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguirá procesándose en este dispositivo. Puedes cerrar esto."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इसी डिवाइस पर प्रोसेस होता रहेगा। आप इसे बंद कर सकते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processamento continua neste aparelho. Você pode fechar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обработка продолжится на этом устройстве. Это окно можно закрыть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обробка триватиме на цьому пристрої. Це вікно можна закрити."
          }
        }
      }
    },
    "Its notes are kept, just without a folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizen bleiben erhalten, nur ohne Ordner."
