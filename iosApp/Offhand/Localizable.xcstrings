    "Everything in Pro is already unlocked. No payment and no account. When the trial ends you keep the free version unless you upgrade." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles aus Pro ist schon freigeschaltet. Ohne Zahlung, ohne Konto. Wenn die Testphase endet, behältst du die kostenlose Version, außer du upgradest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything in Pro is already unlocked. No payment and no account. When the trial ends you keep the free version unless you upgrade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo de Pro ya está desbloqueado. Sin pago y sin cuenta. Cuando termine la prueba te quedas con la versión gratis, salvo que mejores."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro की हर सुविधा पहले से खुली है। कोई भुगतान नहीं, कोई खाता नहीं। ट्रायल खत्म होने पर आपके पास मुफ़्त संस्करण रहेगा, जब तक आप अपग्रेड न करें।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo do Pro já está liberado. Sem pagamento e sem conta. Quando o teste acabar você fica com a versão grátis, a menos que faça upgrade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все возможности Pro уже открыты. Без оплаты и без аккаунта. Когда пробный период закончится, у вас останется бесплатная версия, если вы не перейдёте на Pro."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі можливості Pro вже відкрито. Без оплати й без облікового запису. Коли пробний період закінчиться, у вас залишиться безкоштовна версія, якщо ви не перейдете на Pro."
          }
        }
      }
    },
    "Everything in the Pro column is yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles in der Pro-Spalte gehört dir."
