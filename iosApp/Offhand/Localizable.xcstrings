    "Your notes are kept. Offhand will need to download the model again before it can process a new recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen bleiben erhalten. Offhand muss das Modell erneut herunterladen, bevor es eine neue Aufnahme verarbeiten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas se conservan. Offhand tendrá que descargar el modelo de nuevo antes de poder procesar una grabación nueva."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नोट्स सुरक्षित रहेंगे। नई रिकॉर्डिंग प्रोसेस करने से पहले Offhand को मॉडल दोबारा डाउनलोड करना होगा।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas notas são mantidas. O Offhand vai precisar baixar o modelo de novo antes de processar uma nova gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши заметки сохраняются. Прежде чем обработать новую запись, Offhand потребуется снова скачать модель."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші нотатки зберігаються. Перш ніж обробити новий запис, Offhand доведеться знову завантажити модель."
          }
        }
      }
    },
    "Your notes stay locked until this device confirms it's you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen bleiben gesperrt, bis dieses Gerät bestätigt, dass du es bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas permanecen bloqueadas hasta que este dispositivo confirme que eres tú."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब तक यह डिवाइस पुष्टि नहीं कर देता कि यह आप ही हैं, आपके नोट्स लॉक रहते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas notas ficam bloqueadas até este aparelho confirmar que é você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши заметки остаются заблокированными, пока это устройство не подтвердит, что это вы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші нотатки лишаються заблокованими, доки цей пристрій не підтвердить, що це ви."
          }
        }
      }
    },
