    "Anonymous usage statistics and crash reports — things like app opens, device model and app version. Never your notes, audio, or any personal data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anonyme Nutzungsstatistiken und Absturzberichte — Dinge wie App-Starts, Gerätemodell und App-Version. Niemals deine Notizen, Audio oder persönliche Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estadísticas de uso anónimas e informes de errores: cosas como aperturas de la app, modelo del dispositivo y versión de la app. Nunca tus notas, tu audio ni datos personales."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गुमनाम उपयोग आंकड़े और क्रैश रिपोर्ट — जैसे ऐप खुलने की संख्या, डिवाइस मॉडल और ऐप वर्शन। आपके नोट्स, ऑडियो या कोई निजी डेटा कभी नहीं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estatísticas de uso anônimas e relatórios de falhas — coisas como aberturas do app, modelo do aparelho e versão do app. Nunca suas notas, seu áudio ou dados pessoais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонимная статистика использования и отчёты о сбоях — например, запуски приложения, модель устройства и версия приложения. Никогда — ваши заметки, аудио или личные данные."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анонімна статистика використання і звіти про збої — наприклад, запуски застосунку, модель пристрою та версія застосунку. Ніколи — ваші нотатки, аудіо чи особисті дані."
          }
        }
      }
    },
    "Ask for Face ID, Touch ID, or your passcode every time Offhand opens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
