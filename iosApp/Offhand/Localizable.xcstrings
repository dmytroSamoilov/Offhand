    "Notes outside your folders appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen ohne Ordner erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
