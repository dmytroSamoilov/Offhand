    "A clean write-up of what was said, without repetition or filler." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine saubere Ausarbeitung des Gesagten – ohne Wiederholungen und Füllwörter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una redacción limpia de lo que se dijo, sin repeticiones ni relleno."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो कहा गया उसका साफ़-सुथरा लेख, बिना दोहराव और फ़ालतू बातों के।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um texto limpo do que foi dito, sem repetições nem enchimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккуратное изложение сказанного — без повторов и лишних слов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акуратний виклад сказаного — без повторів і зайвих слів."
          }
        }
      }
    },
