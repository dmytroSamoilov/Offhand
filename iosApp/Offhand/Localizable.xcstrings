    "%@ per month, renews automatically. Cancel anytime in your store account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Monat, verlängert sich automatisch. Jederzeit im Store-Konto kündbar."
