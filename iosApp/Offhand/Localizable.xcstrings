        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o acesso ao microfone para gravar uma nota. Mesmo assim, o áudio nunca sai deste aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите доступ к микрофону, чтобы записать заметку. Звук всё равно никогда не покидает это устройство."
