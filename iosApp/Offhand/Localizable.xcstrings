    "Offhand keeps every recording and note on this device. Nothing is uploaded anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand behält jede Aufnahme und Notiz auf diesem Gerät. Nichts wird irgendwohin hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand guarda cada grabación y cada nota en este dispositivo. No se sube nada a ninguna parte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand हर रिकॉर्डिंग और नोट इसी डिवाइस पर रखता है। कुछ भी कहीं अपलोड नहीं होता।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offhand mantém cada gravação e nota neste aparelho. Nada é enviado para lugar nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand хранит все записи и заметки на этом устройстве. Ничего никуда не загружается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand зберігає всі записи й нотатки на цьому пристрої. Ніщо нікуди не вивантажується."
          }
        }
      }
    },
    "Offhand needs more memory to run its on-device AI models." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand braucht mehr Arbeitsspeicher, um seine On-Device-KI-Modelle auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand necesita más memoria para ejecutar sus modelos de IA en el dispositivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑन-डिवाइस AI मॉडल चलाने के लिए Offhand को ज़्यादा मेमोरी चाहिए।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offhand precisa de mais memória para executar seus modelos de IA no aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand нужно больше памяти, чтобы запускать модели ИИ на устройстве."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand потрібно більше памʼяті, щоб запускати моделі ШІ на пристрої."
          }
        }
      }
    },
    "Offhand needs the microphone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand braucht das Mikrofon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand necesita el micrófono"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand को माइक्रोफ़ोन चाहिए"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offhand precisa do microfone"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand нужен микрофон"
          }
        },
        "uk" : {
          "stringUnit" : {
