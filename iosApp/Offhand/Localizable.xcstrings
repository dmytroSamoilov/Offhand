        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись будет расшифрована и обработана заново; текущие название, резюме и расшифровка будут заменены. Сама аудиозапись сохранится."
          }
        },
        "uk" : {
