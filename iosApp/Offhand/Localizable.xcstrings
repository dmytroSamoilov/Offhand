    "It will keep processing on this device. You can close this." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verarbeitung läuft auf diesem Gerät weiter. Du kannst das hier schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguirá procesándose en este dispositivo. Puedes cerrar esto."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इसी डिवाइस पर प्रोसेस होता रहेगा। आप इसे बंद कर सकते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processamento continua neste aparelho. Você pode fechar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обработка продолжится на этом устройстве. Это окно можно закрыть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обробка триватиме на цьому пристрої. Це вікно можна закрити."
          }
        }
      }
    },
    "Its notes are kept and go back to All notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Notizen bleiben erhalten und landen wieder unter „Alle Notizen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus notas se conservan y vuelven a Todas las notas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके नोट्स सुरक्षित रहेंगे और सभी नोट्स में वापस आ जाएंगे।"
          }
        },
        "pt-BR" : {
