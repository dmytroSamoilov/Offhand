        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल पढ़ी या लिखी नहीं जा सकी।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
