    "Offhand keeps every recording and note on this device. Nothing is uploaded anywhere." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand behält jede Aufnahme und Notiz auf diesem Gerät. Nichts wird irgendwohin hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand guarda cada grabación y cada nota en este dispositivo. No se sube nada a ninguna parte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand हर रिकॉर्डिंग और नोट इसी डिवाइस पर रखता है। कुछ भी कहीं अपलोड नहीं होता।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offhand mantém cada gravação e nota neste aparelho. Nada é enviado para lugar nenhum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand хранит все записи и заметки на этом устройстве. Ничего никуда не загружается."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand зберігає всі записи й нотатки на цьому пристрої. Ніщо нікуди не вивантажується."
          }
        }
      }
    },
    "Offhand makes one encrypted file. You decide where it is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand erstellt eine verschlüsselte Datei. Du entscheidest, wo sie liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand makes one encrypted file. You decide where it is kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand crea un archivo cifrado. Tú decides dónde se guarda."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand एक एन्क्रिप्टेड फ़ाइल बनाता है। उसे कहां रखना है, यह आप तय करते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offhand cria um arquivo criptografado. Você decide onde ele fica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand создаёт один зашифрованный файл. Где его хранить, решаете вы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand створює один зашифрований файл. Де його зберігати, вирішуєте ви."
          }
        }
      }
    },
    "Offhand needs" : {
