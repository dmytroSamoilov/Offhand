    },
    "The file is made on your iPhone and goes only where you send it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei wird auf deinem iPhone erstellt und geht nur dorthin, wohin du sie schickst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is made on your iPhone and goes only where you send it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se crea en tu iPhone y solo va adonde lo envíes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ाइल आपके iPhone पर बनती है और सिर्फ़ वहीं जाती है जहाँ आप उसे भेजते हैं।"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
