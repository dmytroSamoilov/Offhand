    "Offhand is made by one developer. Anonymous usage numbers show me what to fix next." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand is made by one developer. Anonymous usage numbers show me what to fix next."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand wird von einem einzigen Entwickler gemacht. Anonyme Nutzungszahlen zeigen mir, was ich als Nächstes verbessern sollte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand lo hace un solo desarrollador. Las cifras de uso anónimas me muestran qué arreglar primero."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offhand को एक ही डेवलपर बनाता है। गुमनाम उपयोग के आंकड़े मुझे बताते हैं कि आगे क्या ठीक करना है।"
