<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/record_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/record_widget_strip_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <ImageView
        android:id="@+id/record_widget_mark"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:src="@drawable/record_widget_mark_record" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/record_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/record_widget_record"
            android:textColor="#0E1116"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/record_widget_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#5F6672"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/record_widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="monospace"
        android:letterSpacing="-0.03"
        android:maxLines="1"
        android:textColor="#F2F4F7"
        android:textSize="20sp"
        android:visibility="gone" />
</LinearLayout>
